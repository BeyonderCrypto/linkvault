# ============================================================
# Variables de Entorno para Turso Cloud SQLite (Opcional en local, Requerido en Netlify)
# Crea tu base de datos gratuita en https://turso.tech
# ============================================================
TURSO_DATABASE_URL=libsql://tu-base-de-datos-tu-usuario.turso.io
TURSO_AUTH_TOKEN=tu_token_de_autenticacion_turso_aqui

# ============================================================
# Google Authentication (OAuth 2.0 / Google Identity Services)
# Obtén tu Client ID en https://console.cloud.google.com/apis/credentials
# ============================================================
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
SESSION_SECRET=genera_una_clave_secreta_aleatoria_para_sesiones
